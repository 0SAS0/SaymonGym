# Copy to .env on the deployment host. Use an immutable label for the checkout.
APP_REV=security-hardening-v1
API_TARGET=default
SAYMONGYM_ENV_FILE=/srv/saymongym/config/public.env
STATE_DIR=/srv/saymongym/state
DOMAIN=gym.example.net
ORIGIN=https://gym.example.net
RP_ID=gym.example.net
RP_NAME=SaymonGym
# Replace the example with the administrator's public IP or CIDR.
ADMIN_NET=192.0.2.10/32
# Default: all local IPv4 addresses. Set a dedicated local IP when sharing the host.
CADDY_BIND_IP=
CADDY_ADMIN_ONLY=0
# Set CADDY_IMAGE to a reviewed Caddy image tag or digest before deployment.

INVITE_ONLY=1
FIRST_USER_ADMIN=0
ALLOW_GUEST=0
PASSWORD_LOGIN=0
SESSION_DAYS=30
SESSION_SAMESITE=strict
ADMIN_DATA_VIEW=off

API_TOKENS=off
MCP=off
COACH_DISABLED=1
COACH_CHATGPT_PLAN=off
TRAINERS=off
LIBRARY=off
INTEGRATIONS=
INTEGRATIONS_ALLOW_LAN=0
ALLOWED_PRIVATE_IPS=
AUDIT_LOG=1
AUDIT_IP=net
